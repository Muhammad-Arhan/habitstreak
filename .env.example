# ─── HabitStreak Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to git.
# ──────────────────────────────────────────────────────────────────────────────

# Connection string for the main development database.
# When running with Docker Compose, the hostname is "db" (the service name).
# When running locally without Docker, use "localhost".
DATABASE_URL="postgresql://postgres:password@localhost:5432/habitstreak"

# Connection string for the test database.
# Used by integration tests so they never touch your dev data.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/habitstreak_test"

# Port the Express server listens on.
PORT=5000

# Node environment. Options: development | production | test
NODE_ENV=development
