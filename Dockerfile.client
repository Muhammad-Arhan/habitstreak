# ─── Stage 1: Builder ─────────────────────────────────────────────────────────
# Install dependencies and build the React app with Vite.
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY client/package*.json ./
RUN npm install

# Copy source files and build
COPY client/ ./
RUN npm run build

# ─── Stage 2: Nginx Server ────────────────────────────────────────────────────
# Serve the static build output with nginx.
FROM nginx:alpine AS runner

# Copy the Vite build output to nginx's web root
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom nginx config to handle SPA routing and proxy API calls
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
